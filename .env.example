# LazyFlow AI Environment Configuration

# Ollama local instance settings (default: http://127.0.0.1:11434)
OLLAMA_BASE_URL="http://127.0.0.1:11434"
OLLAMA_MODEL="gemma2:2b"

# Optional: Remote Gemini development fallback (only if Ollama is not available locally)
GEMINI_API_KEY=""

# Server Port
PORT=3000

# Application URL
APP_URL="http://localhost:3000"
